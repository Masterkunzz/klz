rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'adminklz@klz.app';
    }

    function isStaff() {
      return request.auth != null
        && request.auth.token.email in ['adminklz@klz.app', 'kasirklz@klz.app'];
    }

    // Produk, seller, kategori: semua staff baca, hanya admin ubah
    match /products/{id} {
      allow read: if isStaff();
      allow create, update, delete: if isAdmin();
    }

    match /sellers/{id} {
      allow read: if isStaff();
      allow create, update, delete: if isAdmin();
    }

    match /categories/{id} {
      allow read: if isStaff();
      allow create, update, delete: if isAdmin();
    }

    // Pesanan: staff bisa buat & ralat, hanya admin bisa hapus
    match /orders/{id} {
      allow read: if isStaff();
      allow create, update: if isStaff()
        && request.resource.data.total is number
        && request.resource.data.items is list;
      allow delete: if isAdmin();
    }
  }
}
